{
  "name": "cc-proxy",
  "version": "1.0.0",
  "description": "Proxy to convert Anthropic API requests to OpenAI format for Claude Code",
  "bin": {
    "cc-proxy": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:native": "cargo build --manifest-path native/Cargo.toml --release",
    "build:release": "npm run build && npm run obfuscate:dist",
    "start": "node dist/cli.js",
    "dev": "npx ts-node src/cli.ts",
    "test": "jest",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "lint": "eslint src/**/*.ts tests/**/*.ts tests/**/*.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:native": "cargo fmt --manifest-path native/Cargo.toml --check && cargo clippy --manifest-path native/Cargo.toml --all-targets -- -D warnings",
    "obfuscate:dist": "node scripts/obfuscate-dist.mjs",
    "prepublishOnly": "npm test -- --runInBand && npm run test:native && npm run lint && npm run lint:native && npm run build:release",
    "test:protocol": "node tests/protocol-parity.mjs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-code-adapter",
    "openai-to-claude",
    "openai",
    "anthropic",
    "proxy",
    "cc-proxy",
    "api",
    "claude-code",
    "llm",
    "ai"
  ],
  "author": "jingdi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chenxicheng/cc-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/Chenxicheng/cc-proxy/issues"
  },
  "homepage": "https://github.com/Chenxicheng/cc-proxy",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "inquirer": "^8.2.6"
  },
  "bundleDependencies": [
    "chalk",
    "commander",
    "inquirer"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "0.71.2",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "javascript-obfuscator": "^5.4.3",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
